# Copy to .env.local. Compose requires: docker compose --env-file .env.local ...
# Shell environment variables take precedence over this file.

# Upstream Dokku version and custom image repository (without a tag).
# The version is used for both the base image and the custom image tag.
DOKKU_VERSION=0.38.34
LAUNCHPAD_IMAGE=launchpad/dokku

# Compose project and container identity.
COMPOSE_PROJECT_NAME=launchpad
DOKKU_CONTAINER_NAME=dokku
DOKKU_RESTART_POLICY=unless-stopped

# Base hostname without a scheme or wildcard. Apps use <app>.example.com.
DOKKU_HOSTNAME=example.com

# Keep bridge for sibling app connectivity. Do not use host/none with these ports.
DOKKU_NETWORK_MODE=bridge
# Local-only by default. 0.0.0.0 exposes ALL published ports, including SSH.
DOKKU_BIND_IP=127.0.0.1
DOKKU_SSH_PORT=3022
DOKKU_HTTP_PORT=9080
DOKKU_HTTPS_PORT=8443

# Repository-local state, expanded to an absolute path by Compose.
# Run Compose from the repository root. For another location, use an absolute
# physical host path; do not use ~ or a relative path.
# Changing the data directory does not migrate existing Dokku state.
DOKKU_DATA_DIR=${PWD}/.data/dokku
# Docker socket access grants host-level control.
DOCKER_SOCKET_PATH=/var/run/docker.sock
