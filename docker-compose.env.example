# Placeholders only. Copy to docker-compose.env (a name Git does not track; see .gitignore), replace
# every CHANGE_ME and use it with:
#   docker compose --env-file docker-compose.env -f docker-compose.yaml ...
# Never commit real values. Generate secrets with a password manager or `openssl rand -hex 32`.
# Shell environment variables take precedence over this file.

# --- Required: secrets and identity -------------------------------------------------------------
# URL-safe characters only (hex): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_HEX_PASSWORD
# At least 32 random characters.
LAUNCHPAD_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# Lowercase UUID naming this router instance (`uuidgen | tr A-Z a-z`).
LAUNCHPAD_ALIAS_INSTANCE_ID=00000000-0000-4000-8000-000000000000

# --- Required: domains --------------------------------------------------------------------------
# Exact https management origin with no path, and an apps domain on a DIFFERENT registrable domain.
LAUNCHPAD_BASE_URL=https://control.example.com
LAUNCHPAD_APPS_DOMAIN=sites.example.net

# --- Required: absolute HOST paths (created by you; bind mounts are never auto-created) ----------
# Dokku state. Dokku's host-path settings are derived from this exact physical path.
DOKKU_DATA_DIR=/srv/launchpad/dokku
# Backups (admin service). Must be owned by 10001:10001 and live outside every cleanup target.
LAUNCHPAD_BACKUP_DIR=/srv/launchpad/backups
# Read-only credential files mounted into the worker and the admin service.
LAUNCHPAD_DOKKU_SSH_KEY_FILE=/srv/launchpad/credentials/dokku_ed25519
LAUNCHPAD_DOKKU_KNOWN_HOSTS_FILE=/srv/launchpad/credentials/known_hosts
# Mode 0600, owned by 10001, a regular file (not a symlink): see docs/install.md.
LAUNCHPAD_ROUTER_TOKEN_FILE=/srv/launchpad/credentials/router-control-token
LAUNCHPAD_ROUTER_EPOCH_FILE=/srv/launchpad/credentials/router-epoch
# Operator-issued PEM certificate chain with DNS SAN `router`, and its private key.
# Key must be a regular file, mode 0600, owned by 10001. No CA private key is mounted.
LAUNCHPAD_ROUTER_TLS_CERT_FILE=/srv/launchpad/tls/router.pem
LAUNCHPAD_ROUTER_TLS_KEY_FILE=/srv/launchpad/tls/router.key
# Public issuing CA bundle, readable by uid 10001; used only by control clients.
LAUNCHPAD_ROUTER_TLS_CA_FILE=/srv/launchpad/tls/control-ca.pem
# Numeric group id of the Docker socket on this host: `stat -c %g /var/run/docker.sock`.
DOCKER_SOCKET_GID=0
# DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- Safe defaults: features off, nothing public -------------------------------------------------
# Enable only after docs/production-compose.md's checks. Controller and worker both get these.
LAUNCHPAD_DEPLOYMENTS=off
LAUNCHPAD_ALIASES=off
LAUNCHPAD_TRUSTED_PROXY=false
LAUNCHPAD_API_DOCS=false
# Public signup is always off in this file; enrollment is operator-managed.

# --- Host bindings: loopback by default; internal ports are 3000/22/80/443/5432 ------------------
# CONTROLLER_BIND_IP=127.0.0.1
# CONTROLLER_HOST_PORT=32180
# DOKKU_SSH_BIND_IP=127.0.0.1
# DOKKU_SSH_HOST_PORT=32222
# PREVIEW_BIND_IP=127.0.0.1
# PREVIEW_HTTP_HOST_PORT=32181
# PREVIEW_HTTPS_HOST_PORT=32443
# Alias router data plane (approved loopback allocation). Control is never published.
# ROUTER_DATA_HOST_PORT=32182

# --- Images: tag plus digest (docs/production-compose.md) ------------------------------------
# Name of the network Dokku and its app containers share (a fixed name; Dokku's
# `network:set --global initial-network` must be set to the same value).
# LAUNCHPAD_APPS_NETWORK=launchpad-apps
# LAUNCHPAD_IMAGE_TAG=local
# LAUNCHPAD_VERSION=unknown
# POSTGRES_IMAGE=postgres:17-alpine@sha256:526f86d93c6ea08fd3f1fe5605650cacc781b2c6013169a0ad8f42c7d3d84f32
# DOKKU_VERSION=0.38.34
# The app base defaults to nginx:1.27-alpine pinned by digest (see docs/production-compose.md).
# LAUNCHPAD_BASE_IMAGE=nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# --- Optional shared limits (identical on controller and worker; empty means the built-in default)
# LAUNCHPAD_MAX_UPLOAD_BYTES=
# LAUNCHPAD_MAX_EXPANDED_BYTES=
# LAUNCHPAD_MAX_ARCHIVE_ENTRIES=
# LAUNCHPAD_MAX_ARCHIVE_DEPTH=
# LAUNCHPAD_MAX_APPS=
# LAUNCHPAD_MAX_DEPLOYMENTS=
