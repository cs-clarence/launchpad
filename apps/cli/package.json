{
    "name": "@launchpad/cli",
    "version": "0.0.0",
    "private": true,
    "description": "The launchpad command-line client",
    "bin": {
        "launchpad": "./src/index.ts"
    },
    "type": "module",
    "scripts": {
        "build": "bun build src/index.ts --target=bun --outdir=dist",
        "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "test:unit": "bun --bun vitest run --config vitest.config.unit.ts"
    },
    "dependencies": {
        "@commander-js/extra-typings": "catalog:",
        "@launchpad/client-core": "workspace:^",
        "@launchpad/sdk": "workspace:^",
        "commander": "catalog:"
    },
    "devDependencies": {
        "@launchpad/tsconfig": "workspace:^",
        "@launchpad/vite-config": "workspace:^",
        "@launchpad/vitest-config": "workspace:^",
        "@types/bun": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
