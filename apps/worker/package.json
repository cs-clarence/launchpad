{
    "name": "@launchpad-kit/worker",
    "version": "0.0.0",
    "private": true,
    "description": "The privileged deployment worker: builds images and talks to Dokku",
    "type": "module",
    "scripts": {
        "build": "bun build src/index.ts --target=bun --outdir=dist",
        "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "test:unit": "bun --bun vitest run --config vitest.config.unit.ts",
        "test:integration": "bun --bun vitest run --config vitest.config.integration.ts",
        "test:live": "bun --bun vitest run --config vitest.config.live.ts"
    },
    "dependencies": {
        "@launchpad-kit/alias-router": "workspace:^",
        "@launchpad-kit/database": "workspace:^",
        "@launchpad-kit/dokku": "workspace:^",
        "@launchpad-kit/services": "workspace:^",
        "tar": "catalog:"
    },
    "devDependencies": {
        "@launchpad-kit/tsconfig": "workspace:^",
        "@launchpad-kit/vite-config": "workspace:^",
        "@launchpad-kit/vitest-config": "workspace:^",
        "@types/bun": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
