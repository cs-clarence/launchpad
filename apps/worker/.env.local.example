# Worker settings (apps/worker; see its README). This is the environment for the worker's
# process (a process manager, a container, a service unit). Do NOT copy it to
# apps/worker/.env.local: Omni loads that file for the worker's tests, including the opt-in
# live suite, where it would override the disposable Dokku you point them at. Examples use
# placeholders: use your own hosts and paths, and never commit real credentials.

# The worker is idle unless this is on, and the controller must have it on too.
LAUNCHPAD_DEPLOYMENTS=off

# Same database and data directory as the controller. The data directory must be readable and
# writable by the same user as the controller's (the worker builds in build/ and collects,
# moves and restores archives the controller wrote).
DATABASE_URL=postgres://launchpad:change-me@postgres.example.com:5432/launchpad
LAUNCHPAD_DATA_DIR=/srv/launchpad/data

# The Dokku host. Keep the private key (mode 600) and known_hosts outside images; mount them
# read-only. The host key must be pinned out of band.
DOKKU_SSH_HOST=dokku.example.com
DOKKU_SSH_PORT=22
DOKKU_SSH_USER=dokku
DOKKU_SSH_KEY_PATH=/run/secrets/dokku_key
DOKKU_SSH_KNOWN_HOSTS_PATH=/run/secrets/dokku_known_hosts

# Where the worker reaches Dokku's proxy for the readiness probe (no DNS needed: the preview's
# name is sent as the Host header).
LAUNCHPAD_PREVIEW_PROXY_URL=http://dokku.example.com:80

# The archive limits the controller enforces, applied again when the worker extracts: give
# both processes the same values, or valid uploads fail at extraction. (Defaults shown.)
# LAUNCHPAD_MAX_EXPANDED_BYTES=209715200
# LAUNCHPAD_MAX_ARCHIVE_ENTRIES=5000
# LAUNCHPAD_MAX_ARCHIVE_DEPTH=16

# Optional: the web server image (pin it by digest in production), the Docker client and engine.
# LAUNCHPAD_BASE_IMAGE=nginx:1.27-alpine
# LAUNCHPAD_DOCKER_BIN=docker
# DOCKER_HOST=unix:///var/run/docker.sock

# Optional: identity (1 to 128 characters, default hostname-pid), the version the operator
# sees, polling and the lease.
# LAUNCHPAD_WORKER_ID=worker-1
# LAUNCHPAD_VERSION=
# LAUNCHPAD_WORKER_POLL_MS=2000
# LAUNCHPAD_WORKER_LEASE_MS=900000

# Scheduled expiry, deletion and cleanup. Off by default: nothing is destroyed. Set it on the
# controller too. The first time it is switched on, previews expiring within 24 hours get 24
# hours from then, once.
# LAUNCHPAD_LIFECYCLE=off
# How long stored archives are kept after their preview is deleted (at least 1h).
# LAUNCHPAD_ARTIFACT_RETENTION=7d
