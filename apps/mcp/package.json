{
    "name": "@launchpad-kit/mcp",
    "version": "0.0.0",
    "private": true,
    "description": "Local stdio MCP adapter for Launchpad",
    "license": "Apache-2.0",
    "bin": {
        "launchpad-mcp": "./dist/mcp.mjs"
    },
    "type": "module",
    "scripts": {
        "build": "vite build",
        "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "test:unit": "bun --bun vitest run --config vitest.config.unit.ts"
    },
    "dependencies": {
        "@commander-js/extra-typings": "catalog:",
        "@launchpad-kit/client-core": "workspace:^",
        "@launchpad-kit/sdk": "workspace:^",
        "@modelcontextprotocol/sdk": "catalog:",
        "commander": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@launchpad-kit/tsconfig": "workspace:^",
        "@launchpad-kit/vite-config": "workspace:^",
        "@launchpad-kit/vitest-config": "workspace:^",
        "@types/node": "catalog:",
        "tar": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
