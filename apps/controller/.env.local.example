# Future runtime settings; placeholders only. No connection is made at bootstrap.
DATABASE_URL=postgresql://launchpad:CHANGE_ME@postgres:5432/launchpad
PORT=3000

# From a controller container, use a reachable Dokku SSH endpoint, not localhost.
# Keep private keys/known_hosts outside the image and mount them read-only.
DOKKU_SSH_HOST=dokku
DOKKU_SSH_PORT=22
DOKKU_SSH_USER=dokku
DOKKU_SSH_KEY_PATH=/run/secrets/dokku_key
DOKKU_SSH_KNOWN_HOSTS_PATH=/run/secrets/dokku_known_hosts
