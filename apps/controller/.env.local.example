# Controller settings. Copy to apps/controller/.env.local (ignored by Git) and edit.
# Every value here is an example; see apps/controller/README.md for meanings.
DATABASE_URL=postgresql://launchpad:CHANGE_ME@127.0.0.1:5432/launchpad
# At least 32 random characters, e.g. `openssl rand -base64 48`. Never commit it.
LAUNCHPAD_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
# Public URL of the controller; its origin is the only trusted origin.
LAUNCHPAD_BASE_URL=https://control.example.com

# operator (default) or invitation (needs the SMTP settings below).
LAUNCHPAD_ENROLLMENT=operator
LAUNCHPAD_PUBLIC_SIGNUP=false
# Optional email. smtps:// or smtp:// (STARTTLS required unless loopback); no query options.
# LAUNCHPAD_SMTP_URL=smtps://user:password@mail.example.com:465
# LAUNCHPAD_EMAIL_FROM=Launchpad <launchpad@example.com>

# true only behind exactly one proxy that appends the client to X-Forwarded-For.
LAUNCHPAD_TRUSTED_PROXY=false
# false removes the OpenAPI document and Scalar reference.
LAUNCHPAD_API_DOCS=true

# Where stored site archives and durable recovery records live.
# This existing directory must be mounted/available; startup refuses a missing directory.
LAUNCHPAD_DATA_DIR=.data/controller

HOST=127.0.0.1
PORT=3000
