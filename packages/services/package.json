{
    "name": "@launchpad-kit/services",
    "version": "0.0.0",
    "private": true,
    "description": "Framework-independent controller services",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": {
                "development": "./src/index.ts",
                "default": "./src/index.ts"
            },
            "require": {
                "development": "./src/index.ts",
                "default": "./src/index.ts"
            }
        },
        "./testing": {
            "types": "./src/testing/tar-fixtures.ts",
            "import": {
                "development": "./src/testing/tar-fixtures.ts",
                "default": "./src/testing/tar-fixtures.ts"
            },
            "require": {
                "development": "./src/testing/tar-fixtures.ts",
                "default": "./src/testing/tar-fixtures.ts"
            }
        }
    },
    "scripts": {
        "build": "vite build",
        "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "test:unit": "bun --bun vitest run --config vitest.config.unit.ts",
        "test:integration": "bun --bun vitest run --config vitest.config.integration.ts"
    },
    "dependencies": {
        "@launchpad-kit/contracts": "workspace:^",
        "@launchpad-kit/database": "workspace:^",
        "kysely": "catalog:",
        "tar": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@launchpad-kit/tsconfig": "workspace:^",
        "@launchpad-kit/vite-config": "workspace:^",
        "@launchpad-kit/vitest-config": "workspace:^",
        "@types/bun": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
