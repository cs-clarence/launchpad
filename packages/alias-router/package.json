{
    "name": "@launchpad-kit/alias-router",
    "version": "0.1.0-rc.1",
    "private": true,
    "description": "Bun-only durable generation-checked alias routing authority (unwired core)",
    "type": "module",
    "exports": {
        "./control-client": {
            "types": "./src/control-client.ts",
            "default": "./src/control-client.ts"
        },
        ".": {
            "types": "./src/index.ts",
            "import": {
                "development": "./src/index.ts",
                "default": "./src/index.ts"
            },
            "require": {
                "development": "./src/index.ts",
                "default": "./src/index.ts"
            }
        }
    },
    "scripts": {
        "build": "vite build",
        "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "test:unit": "bun --bun vitest run --config vitest.config.unit.ts",
        "test:integration": "bun --bun vitest run --config vitest.config.integration.ts"
    },
    "dependencies": {
        "zod": "catalog:"
    },
    "devDependencies": {
        "@launchpad-kit/tsconfig": "workspace:^",
        "@launchpad-kit/vite-config": "workspace:^",
        "@launchpad-kit/vitest-config": "workspace:^",
        "@types/bun": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
