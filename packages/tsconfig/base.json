{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "customConditions": ["development"]
    },
    "include": ["${configDir}/src/**/*.ts", "${configDir}/src/**/*.tsx"]
}
