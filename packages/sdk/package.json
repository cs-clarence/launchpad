{
    "name": "@launchpad-kit/sdk",
    "version": "0.0.0",
    "private": true,
    "description": "Browser-safe HTTP SDK for the Launchpad controller API",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": {
                "development": "./src/index.ts",
                "default": "./src/index.ts"
            },
            "require": {
                "development": "./src/index.ts",
                "default": "./src/index.ts"
            }
        }
    },
    "scripts": {
        "build": "vite build",
        "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "test:unit": "vitest run --config vitest.config.unit.ts",
        "test:integration": "vitest run --config vitest.config.integration.ts"
    },
    "dependencies": {
        "@launchpad-kit/contracts": "workspace:^",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@launchpad-kit/tsconfig": "workspace:^",
        "@launchpad-kit/vite-config": "workspace:^",
        "@launchpad-kit/vitest-config": "workspace:^",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
