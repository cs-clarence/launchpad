{
    "name": "@launchpad/root",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*",
        "tests/*"
    ],
    "type": "module",
    "scripts": {
        "setup:agents": "omni remote-sources install && omni projection sync",
        "build": "omni -i run build",
        "check": "omni -i run check",
        "check:types": "omni -i run check:types",
        "check:lint": "omni -i run check:lint",
        "check:format": "omni -i run check:format",
        "check:deps": "omni -i run check:deps",
        "format": "omni -i run format",
        "test": "omni -i run test",
        "test:integration": "omni -i run test:integration"
    },
    "devDependencies": {
        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "@typescript/typescript6": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
