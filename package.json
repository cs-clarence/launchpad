{
    "name": "@launchpad/root",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*",
        "tests/*"
    ],
    "type": "module",
    "scripts": {
        "setup:agents": "omni remote-sources install && omni projection sync",
        "check:types": "tsc --noEmit -p tsconfig.tooling.json && bun run --filter '*' check:types",
        "check:lint": "oxlint apps packages",
        "check:format": "oxfmt --check",
        "format": "oxfmt",
        "test": "bun run --filter '*' test:unit",
        "build": "bun run --filter '*' build"
    },
    "devDependencies": {
        "@types/bun": "catalog:",
        "@types/node": "catalog:",
        "@typescript/typescript6": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "packageManager": "bun@1.4.4",
    "catalog": {
        "@types/bun": "1.4.4",
        "@types/node": "26.6.6",
        "typescript": "7.0.2",
        "@typescript/typescript6": "6.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.0",
        "oxfmt": "0.78.0",
        "oxlint": "1.93.0",
        "unplugin-dts": "1.1.2",
        "@vitest/browser-playwright": "5.1.0",
        "playwright": "1.64.1",
        "@omni-oss/log": "0.1.1",
        "zod": "4.6.7",
        "commander": "15.1.0",
        "@commander-js/extra-typings": "15.1.0",
        "elysia": "2.0.0-rc.3",
        "@tanstack/react-start": "1.169.5",
        "@tanstack/react-router": "1.170.46",
        "@vitejs/plugin-react": "6.3.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@skeletonlabs/skeleton": "5.0.4",
        "@skeletonlabs/skeleton-react": "5.0.4",
        "tailwindcss": "4.3.5",
        "@tailwindcss/vite": "4.3.5",
        "nitro": "3.0.261103-rc",
        "kysely": "0.29.9",
        "pg": "8.23.1",
        "@types/pg": "8.23.1"
    }
}
